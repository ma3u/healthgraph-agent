# ============================================================
# Neo4j Connection — works with BOTH Desktop and Aura
# ============================================================

# --- Option A: Neo4j Desktop (local) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-local-password

# --- Option B: Neo4j Aura (cloud) ---
# Get these from console.neo4j.io after creating your instance
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# --- Import Method 2: CSV path for LOAD CSV ---
# When using LOAD CSV, this is the directory where CSVs are served.
# For Desktop: file:///path/to/healthgraph-agent/data/csv/
# For Aura:    upload CSVs to a public URL or use neo4j admin import
CSV_IMPORT_URI=file:///import/

# ============================================================
# Sync backend (FastAPI service the iOS app talks to)
# See backend/README.md for setup details.
# ============================================================
BACKEND_USER=you@example.com
# Generate with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
BACKEND_PASSWORD_HASH=$2b$12$replace-me-with-a-real-bcrypt-hash
BACKEND_JWT_SECRET=change-me-to-a-long-random-string
BACKEND_JWT_TTL_HOURS=720
# Set to 1 to skip Aura writes (local smoke test)
BACKEND_DRY_RUN=0
# Comma-separated list of allowed CORS origins; default "*"
BACKEND_CORS_ORIGINS=*

# ============================================================
# Dashboard embedded in the iOS app (WKWebView)
# ============================================================
# IMPORTANT: wrap any URL containing & in single quotes, otherwise
# bash's `set -a; source .env` will misparse the &.
NEODASH_URL='https://neodash.graphapp.io/?host=<aura-host>.databases.neo4j.io&protocol=neo4j%2Bs&database=neo4j&username=neo4j&dashboardName=<your-dashboard-title-url-encoded>'
