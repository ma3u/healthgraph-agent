# Real Apple Health data — NEVER commit personal health data
data/export.xml
data/export.zip
data/apple_health_export/
data/apple_health_export.zip
data/apple_health_export*.zip

# Synthetic data and CSV exports ARE allowed to commit
# data/export_*.xml  — checked in
# data/csv*/         — checked in

# Generated charts (may contain personal health data)
data/charts/

# Environment
.env
.venv/
venv/
__pycache__/
*.pyc

# IDE
.idea/
.vscode/
*.swp

# Xcode build artifacts — Info.plist is generated by xcodegen from
# ios/project.yml on every build, and scripts/build_ios.sh patches it
# with .env secrets. NEVER commit a patched copy.
ios/HealthGraphSync/Resources/Info.plist
ios/HealthGraphSync.xcodeproj/

# Skills CLI (npx skills add ...) — installed locally, managed via the CLI
.agents/
.claude/

